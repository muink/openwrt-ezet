
config ezet 'config'
	option __warning 'ACCESS CONTROL FIELDS'

config core 'global'
	option console_log_level 'warn'
	option file_log_level 'off'
	option file_log_size '5' # in MB
	option file_log_count '1'

config web 'console'
	option console_log_level 'warn'
	option config_server_protocol 'udp'
	option config_server_port '22020'
	option api_server_port '11211'

config instance 'instance_easytiernode'
	option label 'easytiernode'
	option network_name 'easytiernode'
	option network_secret ''
	option peers 'peer_DreamLife'

config peer 'peer_Official'
	option label 'Official'
	option uri 'tcp://public.easytier.top:11010'

config peer 'peer_DreamLife'
	option label 'DreamLife'
	option uri 'tcp://dreamlife.indevs.in:11010'

config peer 'peer_WindMC'
	option label 'WindMC'
	option uri 'tcp://161.33.207.13:51010'

config listener 'listener_TCP'
	option label 'TCP'
	option type 'listeners'
	option uri 'tcp://0.0.0.0:11010'

config listener 'listener_UDP'
	option label 'UDP'
	option type 'listeners'
	option uri 'udp://0.0.0.0:11010'

config listener 'listener_WireGuard'
	option label 'WireGuard'
	option type 'listeners'
	option uri 'wg://[::]:11011'

