
config ezet 'config'
	option __warning 'ACCESS CONTROL FIELDS'

config core 'global'
	option console_log_level 'warn'
	option file_log_level 'off'
	option file_log_size '5' # in MB
	option file_log_count '1'
	list rpc_portal_whitelist '127.0.0.1'
	list rpc_portal_whitelist '127.0.0.0/8'
	list rpc_portal_whitelist '::1/128'

config web 'console'
	option console_log_level 'warn'
	option file_log_level 'off'
	option config_server_protocol 'udp'
	option config_server_port '22020'
	option api_server_port '11211'
	option api_host 'http://192.168.1.1:11211'

config instance 'instance_example'
	option label 'ezetnode'
	option network_name 'ezetnode'
	option network_secret ''
	option peers 'peer_DreamLife'

config stun_server
	option label 'HiTV'
	option host 'stun.hitv.com:3478'
	option l3 'ipv4'
	option capabilities 'udp'

config stun_server
	option label 'pure-ip'
	option host 'stun.pure-ip.com'
	option l3 'ipv4,ipv6'
	option capabilities 'udp,tcp'

config stun_server
	option label 'Easytier'
	option host '[2402:4e00:c054:d400:687c:1516:c4d6:0]:8489'
	option l3 'ipv6'
	option capabilities 'udp'

config stun_server
	option label 'fitauto'
	option host 'stun.fitauto.ru'
	option l3 'ipv4'
	option capabilities 'udp,tcp'

config stun_server
	option label 'CloudFlare'
	option host 'turn.cloudflare.com'
	option l3 'ipv4'
	option capabilities 'udp,tcp,tls'

config stun_server
	option label 'Google'
	option host 'stun4.l.google.com:19302'
	option l3 'ipv4,ipv6'
	option capabilities 'udp'

config peer 'peer_Official'
	option label 'Official'
	option uri 'tcp://public.easytier.top:11010'

config peer 'peer_DreamLife'
	option label 'DreamLife'
	option uri 'tcp://dreamlife.indevs.in:11010'

config peer 'peer_WindMC'
	option label 'WindMC'
	option uri 'tcp://161.33.207.13:51010'

config listener 'listener_TCP'
	option label 'TCP'
	option type 'listeners'
	option uri 'tcp://0.0.0.0:11010'

config listener 'listener_UDP'
	option label 'UDP'
	option type 'listeners'
	option uri 'udp://0.0.0.0:11010'

config listener 'listener_WireGuard'
	option label 'WireGuard'
	option type 'listeners'
	option uri 'wg://[::]:11011'

