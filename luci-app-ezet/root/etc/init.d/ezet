#!/bin/sh /etc/rc.common

. "$IPKG_INSTROOT/usr/share/libubox/jshn.sh"

START=97
STOP=90
USE_PROCD=1

CONF="ezet"
BINCORE="/usr/bin/easytier-core"
BINWEB="/usr/bin/easytier-web"

EZ_DIR="/etc/ezet"
EXE_DIR="/usr/libexec/ezet"
SDL_DIR="/usr/share/ezet"
RUN_DIR="/var/run/ezet"
LOG_PATH="$RUN_DIR/ezet.log"

config_load "$CONF"

# add_firewall
add_firewall() {
	local enabled auto_firewall type uri
	config_get_bool enabled "$1" "enabled" "1"
	config_get_bool auto_firewall "$1" "auto_firewall" "1"
	config_get type "$1" "type"
	config_get uri "$1" "uri"

	local used_uris="$2"

	[ "$enabled" = "0" ] && return 0
	[ "$auto_firewall" = "0" ] && return 0
	[ "$type" = "listeners" ] || return 0
	eval "echo $used_uris" | grep -q "$uri" || return 0

	local proto ip port
	eval "$(echo "$uri" \
		| sed -En "s|^([^:]+):/{0,2}\[?([[:xdigit:]:.]+)\]?:(\d+)|proto='\1';ip='\2';port='\3';|p")"
	case "$proto" in
		faketcp|ws|wss) proto=tcp ;;
		wg|quic)        proto=udp ;;
		*)              proto='' ;;
	esac
	json_add_object ''
	json_add_string type rule
	json_add_string target ACCEPT
	json_add_string name "$1"
	#json_add_string family '' # '' = IPv4 and IPv6
	json_add_string proto "${proto:-tcp udp}"
	json_add_string direction in
	json_add_string src "*"
	#json_add_string dest '' # '' = input
	json_add_string dest_ip "$(echo "$ip" | grep -vE '^(0(\.\d+){3}|::)$')"
	json_add_string dest_port "$port"
	json_close_object
}

add_web_firewall() {
	local web_firewall name proto ip port
	config_get web_firewall "config" "web_firewall"

	local config_server_protocol config_server_port
	config_get config_server_protocol "$1" "config_server_protocol" "udp"
	config_get config_server_port "$1" "config_server_port" "22020"
	local api_server_addr api_server_port
	config_get api_server_addr "$1" "api_server_addr"
	config_get api_server_port "$1" "api_server_port" "11211"
	local web_server_addr web_server_port
	config_get web_server_addr "$1" "web_server_addr"
	config_get web_server_port "$1" "web_server_port"
	for _ in $web_firewall; do
		case "$_" in
			config_server)
				name="${1}-config-server"
				proto="$config_server_protocol"
				ip="::"
				port="$config_server_port"
				;;
			api_server)
				name="${1}-api-server"
				proto=""
				ip="$api_server_addr"
				port="$api_server_port"
				;;
			web_server)
				name="${1}-web-server"
				proto=""
				ip="$web_server_addr"
				port="${web_server_port:-$api_server_port}"
				;;
		esac

		json_add_object ''
		json_add_string type rule
		json_add_string target ACCEPT
		json_add_string name "$name"
		#json_add_string family '' # '' = IPv4 and IPv6
		json_add_string proto "${proto:-tcp udp}"
		json_add_string direction in
		json_add_string src "*"
		#json_add_string dest '' # '' = input
		json_add_string dest_ip "$(echo "$ip" | grep -vE '^(0(\.\d+){3}|::)$')"
		json_add_string dest_port "$port"
		json_close_object
	done
}

log() {
	echo -e "$(date "+%Y-%m-%d %H:%M:%S") [DAEMON] $*" >> "$LOG_PATH"
}

start_service() {
	[ "$#" -ge 1 ] && local instance="$1" && shift || true
	local core_enabled web_enabled
	config_get_bool core_enabled "config" "core_enabled" "0"
	config_get_bool web_enabled "config" "web_enabled" "0"

	if [ "$core_enabled" = "0" -a "$web_enabled" = "0" ]; then
		return 1
	fi

	mkdir -p "$RUN_DIR"

	local core_opti core_conf config_files
	# Core
	if [ "$core_enabled" = "1" ]; then
	if [ -z "$instance" -o "$instance" = "easytier-core" ]; then

		# Generate/Validate core configs
		core_conf="$(ucode -S "$SDL_DIR/generate.uc" "$@" 2>>"$LOG_PATH")"
		core_opti="$(echo "$core_conf" | yq -pj '
			.options | to_entries
			| map( "--" + .key + ( (.value | select(. != true) | (" " + (to_string | @sh)) ) // "") )
			| join(" ")
		')"
		#core_opti="$(echo "$core_conf" | yq -pj '
		#	.options | to_entries
		#	| map( "--" + .key + (if .value == true then "" else " " + (.value | tostring | @sh) end) )
		#	| join(" ")
		#')" # Required v4.54.1
		core_conf="$(jsonfilter -qs "$core_conf" -e '@.configs')"

		config_files="$(ubus call luci.ezet write_configs '{"configs":"'"${core_conf//\"/\\\"}"'"}' \
			| yq '(.result | join(" ")) // "Error: \(.error)"')"

		if echo "$config_files" | grep -q '^Error: '; then
			log "${config_files}"
			return 1
		fi

		if [ -n "$config_files" ]; then
			config_files=$(echo " $config_files" | sed 's| | -c |g')
			if ! eval "\"$BINCORE\" $core_opti --check-config $config_files" 2>/dev/null; then
				log "Error: wrong core configuration detected."
				eval "\"$BINCORE\" $core_opti --check-config $config_files" 2>>"$LOG_PATH"
				return 1
			fi
		fi
		echo > "$RUN_DIR/easytier-core.log"

		# easytier-core
		procd_open_instance "easytier-core"

		procd_set_param command /bin/sh
		procd_append_param command -c "'$BINCORE' $core_opti $config_files >> '$RUN_DIR/easytier-core.log' 2>&1"

		procd_set_param limits core="unlimited"
		procd_set_param limits nofile="1000000 1000000"
		procd_set_param stderr 1
		procd_set_param respawn

		# add_firewall
		procd_open_data
		# configure firewall
		json_add_array firewall
			# meta l4proto %s th dport %s counter accept comment "!%s: accept server instance [%s]"
			if [ -n "$config_files" ]; then
			config_foreach add_firewall "listener" "$(yq -ptoml eval-all '
				[
					select((.listeners // []) | length > 0)
					| .listeners[]
				] | unique
				| map( tostring | @sh )
				| join(" ")
			' ${config_files//-c/} 2>/dev/null)"
			fi
		json_close_array
		procd_close_data

		procd_close_instance
	fi
	log "$("$BINCORE" -V) started."
	fi

	local web_opti
	# Web
	if [ "$web_enabled" = "1" -a -n "$(ubus call luci.ezet get_features | yq '.web_version // ""')" ]; then
	if [ -z "$instance" -o "$instance" = "easytier-web" ]; then

		# Generate/Validate web configs
		web_opti="$(ucode -S "$SDL_DIR/generate-web.uc" 2>>"$LOG_PATH" | yq -pj '
			.options | to_entries
			| map( "--" + .key + ( (.value | select(. != true) | (" " + (to_string | @sh)) ) // "") )
			| join(" ")
		')"
		#web_opti="$(ucode -S "$SDL_DIR/generate-web.uc" 2>>"$LOG_PATH" | yq -pj '
		#	.options | to_entries
		#	| map( "--" + .key + (if .value == true then "" else " " + (.value | tostring | @sh) end) )
		#	| join(" ")
		#')" # Required v4.54.1

		echo > "$RUN_DIR/easytier-web.log"

		# easytier-web
		procd_open_instance "easytier-web"

		procd_set_param command /bin/sh
		procd_append_param command -c "'$BINWEB' $web_opti >> '$RUN_DIR/easytier-web.log' 2>&1"

		procd_set_param limits core="unlimited"
		procd_set_param limits nofile="1000000 1000000"
		procd_set_param stderr 1
		procd_set_param respawn

		# add_firewall
		procd_open_data
		# configure firewall
		json_add_array firewall
			# meta l4proto %s th dport %s counter accept comment "!%s: accept server instance [%s]"
			add_web_firewall "console"
		json_close_array
		procd_close_data

		procd_close_instance
	fi
	log "$("$BINWEB" -V) started."
	fi

	# log-cleaner
	procd_open_instance "log-cleaner"
	procd_set_param command "$EXE_DIR/clean_log.sh"
	procd_set_param respawn
	procd_close_instance
}

stop_service() {
	[ "$#" -ge 1 ] && local instance="$1" && shift || true
	# Core
	[ -z "$instance" -o "$instance" = "easytier-core" ] && stop_core "$@"
	# Web
	[ -z "$instance" -o "$instance" = "easytier-web" ] && stop_web
	return 0
}

stop_core() {
	# Remove core log
	rm -f "$RUN_DIR/easytier-core.log"

	# Remove core config
	local arg
	if [ "$#" -ge 1 ]; then
		json_init; json_load '{"arr":[]}'
		json_select "arr"
		for arg in "$@"; do
			json_add_string "" "$arg"
		done
		ubus call luci.ezet write_configs '{"configs":
			"'"$(json_dump | jsonfilter -qe '@.arr' | sed 's|"|\\\"|g')"'",
			"invert":"1"}' >/dev/null # rm $@.toml
	else
		ubus call luci.ezet write_configs '{"configs":""}' >/dev/null # rm *.toml
	fi

	log "Service easytier-core stopped."
}

stop_web() {
	# Remove web log
	rm -f "$RUN_DIR/easytier-web.log"

	log "Service easytier-web stopped."
}

reload_service() {
	log "Reloading service${1:+ $*}..."

	stop  "$@"
	start "$@"
}

service_triggers() {
	procd_add_reload_trigger "$CONF" 'network'
}
